{
  "name": "Email Assistant Agent",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "simple": false,
        "filters": {
          "labelIds": [
            "INBOX"
          ],
          "q": "-from:YOUR_OWN_EMAIL@gmail.com",
          "readStatus": "unread"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.4,
      "position": [
        -560,
        0
      ],
      "id": "45f539a1-16f3-48a7-9912-3b577c043543",
      "name": "Gmail Trigger",
      "retryOnFail": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "bceaa22f-bc5d-47d5-b9d3-54e5b54743f8",
              "leftValue": "={{ $json.from.value[0].address }}",
              "rightValue": "=YOUR_OWN_EMAIL@gmail.com",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        -352,
        0
      ],
      "id": "4545131b-b21e-497a-a5fd-3f7a17d4fee3",
      "name": "If"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "= Summarize this email and suggest a short reply:\n Subject:{{ $('Gmail Trigger').item.json.subject }}\n From: {{ $('Gmail Trigger').item.json.from.text }}\n Body: {{ $('Gmail Trigger').item.json.text }}",
        "options": {
          "systemMessage": "You are an email assistant. Read the incoming email and write a short, \npolite, professional reply. Only output the reply text — no subject, \nno extra commentary, just the message body."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        -144,
        0
      ],
      "id": "903ace39-8825-41ca-8dd6-7e5dae3bcc41",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "options": {}
      },
