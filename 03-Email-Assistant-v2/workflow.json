      "typeVersion": 1.1,
      "position": [
        -144,
        192
      ],
      "id": "bfa4ef8b-ce37-4689-bc60-b619cc2f26d7",
      "name": "Google Gemini Chat Model"
    },
    {
      "parameters": {
        "sendTo": "={{ $('Gmail Trigger').item.json.from.text }}",
        "subject": "=Reply to :{{ $('Gmail Trigger').item.json.subject }}",
        "emailType": "text",
        "message": "={{ $json.output }}",
        "options": {}
      },
      "type": "n8n-nodes-base.gmail",
