      "parameters": {
        "jsCode": "const prices = $('HTTP Request').all().map(item => item.json);\nconst news = $('AI Agent').item.json.output; // apne AI Agent node ka exact naam use karo\n\nconst priceText = prices.map(c => \n  `${c.name} (${c.symbol.toUpperCase()}): $${c.current_price} (${c.price_change_percentage_24h.toFixed(2)}% 24h)`\n).join('\\n');\n\nreturn {\n  json: {\n    priceSummary: priceText,\n    newsSummary: news\n  }\n};"
      },
