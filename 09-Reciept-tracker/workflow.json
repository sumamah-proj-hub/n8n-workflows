        "jsCode": "const rawText = $input.item.json.content.parts[0].text;\nconst cleanText = rawText.replace(/```json|```/g, '').trim();\n\nlet data;\ntry {\n  data = JSON.parse(cleanText);\n} catch (e) {\n  data = { merchant: 'Unknown', amount: 0, category: 'other', date: null };\n}\n\nreturn {\n  json: {\n    merchant: data.merchant,\n    amount: data.amount,\n    category: data.category,\n    date: data.date\n  }\n};"
